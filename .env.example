# Copia este archivo a .env.local y rellena los valores de tu app web de Firebase
# (Firebase Console > Configuración del proyecto > Tus apps > Web).
# Son variables públicas de cliente: no pongas aquí claves de cuentas de servicio.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Opcional, solo para desarrollo/pruebas locales: "true" conecta la app a los
# emuladores de Firebase (Auth 127.0.0.1:9099, Firestore 127.0.0.1:8080).
# Déjalo vacío en producción y en Vercel.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=
